# Database
# FOR PM2 (on host): Use file:/home/your-user/NetPatrol/prisma/dev.db
# FOR DOCKER: This will be overridden automatically by docker-compose.yml
DATABASE_URL="file:/app/data/dev.db"

# Server Port
PORT=8765

# Google Gemini AI (Get a key at https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key"

# Slack Webhook (Create one at https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL="your-slack-webhook-url"

# Gmail Credentials (Use a Google App Password)
GMAIL_USER="your-email@gmail.com"
GMAIL_PASS="abcd efgh ijkl mnop"

# Nmap binary location (Usually "nmap")
NMAP_PATH="nmap"
